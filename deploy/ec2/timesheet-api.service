# Install as /etc/systemd/system/timesheet-api.service (see deploy/ec2/README.md).
[Unit]
Description=Mini Timesheets API (Hono)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=timesheet
Group=timesheet
# dotenv loads .env from the working directory, so this must be apps/api.
WorkingDirectory=/opt/timesheet-tracker/apps/api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
